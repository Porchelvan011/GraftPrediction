# .env.template - copy to .env and fill values
# SECURITY: do NOT commit secrets to version control

# App settings
DEBUG=0  # set to 1 for local development only
SECRET_KEY=your-production-secret-key
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Database (least-privileged user suggested below in README)
DB_HOST=localhost
DB_USER=graft_user
DB_PASSWORD=super-secret-password
DB_NAME=graftpredict
DB_POOL_SIZE=5

# Mail (SMTP)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password-or-app-password
MAIL_DEFAULT_SENDER=your-email@example.com

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,exp://127.0.0.1:19000

# Local dev convenience
DEBUG_SHOW_OTP=1

# File storage
USE_S3=0
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Broker for async tasks (optional)
BROKER_URL=

# Gunicorn
GUNICORN_WORKERS=2

# Max upload size (bytes)
MAX_CONTENT_LENGTH=10485760
