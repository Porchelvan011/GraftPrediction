# Copy this file to .env and fill values for local development.
# DO NOT commit your real secrets to version control.

# Required
GOOGLE_CLIENT_ID=278600292660-lejdi9t5j7387045nkqd1velk0qsu63d.apps.googleusercontent.com
SECRET_KEY=replace-with-a-random-secret

# Optional (set for email features)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Debug toggles
DEBUG=false
DEBUG_SHOW_OTP=false

# Server bind
HOST=0.0.0.0
PORT=5000
